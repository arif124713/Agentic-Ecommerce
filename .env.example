# Copy to .env and fill in real values. Never commit .env.

# --- Database (native local MySQL for now; see README for the Docker path) ---
mysql_password=changeme
MYSQL_USER=root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=blackcart

# --- App ---
APP_ENV=local
APP_SECRET_KEY=dev-secret-change-me
APP_BASE_URL=http://localhost:5173
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Chat MCP servers (see chat_implementation_plan.md) ---
# Read-only role provisioned by backend/scripts/provision_analytics_ro.sql — never the primary
# MYSQL_USER. This is what actually enforces "no PII, ever" for the Insights Agent.
ANALYTICS_MYSQL_USER=analytics_ro
ANALYTICS_MYSQL_PASSWORD=changeme

# DeepSeek (spec §1: "the LLM is a router and a writer, never a query engine") — OpenAI-compatible
# endpoint. Never commit a real key here; this file is git-tracked, .env is not.
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
